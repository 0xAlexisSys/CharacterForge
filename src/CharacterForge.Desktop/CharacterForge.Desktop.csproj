<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationManifest>App.manifest</ApplicationManifest>
        <ApplicationIcon>Assets/Icon.ico</ApplicationIcon>
        <Version>1.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets/**"/>

        <ProjectReference Include="$(SourceDirectory)CharacterForge.Infrastructure/CharacterForge.Infrastructure.csproj"/>

        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.Desktop"/>
        <PackageReference Include="Avalonia.Fonts.Inter"/>
        <PackageReference Include="Avalonia.Themes.Fluent"/>
        <PackageReference Include="Material.Icons.Avalonia"/>
        <PackageReference Include="CommunityToolkit.Mvvm"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
        <PackageReference Include="Microsoft.Bcl.Memory"/>
        <PackageReference Include="Microsoft.ML.Tokenizers"/>
        <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase"/>
        <PackageReference Include="JetBrains.Annotations" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="Avalonia.Markup.Xaml.Loader" PrivateAssets="all"/>
        <PackageReference Include="AvaDiagnostics12" PrivateAssets="all"/>
        <PackageReference Include="HotAvalonia" PrivateAssets="all"/>
    </ItemGroup>
</Project>
