<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:CharacterForge.Desktop.ViewModels"
             x:Class="CharacterForge.Desktop.Views.ConfirmModalView"
             x:DataType="viewModels:ConfirmModalViewModel">
    <StackPanel Classes="modal"
                Width="400.0">
        <TextBlock Classes="header"
                   Text="{Binding Title}"/>
        <Separator/>
        <TextBlock Text="{Binding Message}"
                   Foreground="{DynamicResource ForegroundPrimaryBrush}"
                   TextWrapping="Wrap"
                   FontSize="15.0"
                   LineHeight="22.0"/>
        <Separator/>
        <DockPanel Classes="footer">
            <StackPanel Classes="buttons">
                <Button Classes="secondary"
                        Content="{Binding CancelButtonText}"
                        Command="{Binding CancelCommand}"/>
                <Button Classes="danger"
                        Content="{Binding ConfirmButtonText}"
                        Command="{Binding ConfirmCommand}"/>
            </StackPanel>
            <Decorator/>
        </DockPanel>
    </StackPanel>
</UserControl>
