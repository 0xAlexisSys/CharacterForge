<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:CharacterForge.Desktop.ViewModels"
             xmlns:icons="using:Material.Icons.Avalonia"
             x:Class="CharacterForge.Desktop.Views.RefineFieldModalView"
             x:DataType="viewModels:RefineFieldModalViewModel">
    <StackPanel Classes="modal"
                Width="480.0">
        <TextBlock Classes="header"
                   Text="{Binding Title}"/>
        <Separator/>
        <StackPanel Orientation="Vertical"
                    Spacing="6.0">
            <StackPanel Classes="field">
                <StackPanel Classes="header">
                    <TextBlock Classes="label"
                               Text="Included Fields"/>
                    <icons:MaterialIcon ToolTip.Tip="Character card fields to include in the sent user prompt."
                                        Kind="TooltipHelp"
                                        IconSize="20.0"
                                        Background="Transparent"
                                        Padding="2.0"/>
                </StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <CheckBox Content="Description"
                              IsVisible="{Binding ShowDescriptionCheckBox}"
                              IsEnabled="{Binding CanIncludeDescription}"
                              IsChecked="{Binding IncludeDescription}"
                              Margin="0.0 0.0 16.0 0.0"/>
                    <CheckBox Content="Personality"
                              IsVisible="{Binding ShowPersonalityCheckBox}"
                              IsEnabled="{Binding CanIncludePersonality}"
                              IsChecked="{Binding IncludePersonality}"
                              Margin="0.0 0.0 16.0 0.0"/>
                    <CheckBox Content="Scenario"
                              IsVisible="{Binding ShowScenarioCheckBox}"
                              IsEnabled="{Binding CanIncludeScenario}"
                              IsChecked="{Binding IncludeScenario}"
                              Margin="0.0 0.0 16.0 0.0"/>
                    <CheckBox Content="Example Messages"
                              IsVisible="{Binding ShowExampleMessagesCheckBox}"
                              IsEnabled="{Binding CanIncludeExampleMessages}"
                              IsChecked="{Binding IncludeExampleMessages}"/>
                </WrapPanel>
            </StackPanel>

            <StackPanel Classes="field">
                <StackPanel Classes="header">
                    <TextBlock Classes="label"
                               Text="Prompt"/>
                    <icons:MaterialIcon Kind="Required"
                                        IconSize="20.0"
                                        Padding="2.0"/>
                </StackPanel>
                <TextBox Text="{Binding Prompt}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         MinLines="3"
                         MaxLines="3"/>
            </StackPanel>
        </StackPanel>
        <Separator/>
        <DockPanel Classes="footer">
            <StackPanel Classes="buttons">
                <Button Classes="secondary"
                        IsEnabled="{Binding !IsRefining}"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"/>
                <Button Classes="primary"
                        IsEnabled="{Binding CanRefine}"
                        Content="Refine"
                        Command="{Binding RefineCommand}"/>
            </StackPanel>
            <Decorator/>
        </DockPanel>
    </StackPanel>
</UserControl>
