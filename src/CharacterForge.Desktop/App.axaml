<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:CharacterForge.Desktop"
             xmlns:icons="using:Material.Icons.Avalonia"
             x:Class="CharacterForge.Desktop.App"
             RequestedThemeVariant="Dark">
    <Application.DataTemplates>
        <app:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Controls/ImageBox.axaml"/>
                <ResourceInclude Source="/Controls/TagEditor.axaml"/>

                <ResourceInclude Source="/Resources/FontResources.axaml"/>
                <ResourceInclude Source="/Resources/ThemeResources.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>
        <icons:MaterialIconStyles/>
        <StyleInclude Source="/Resources/Styles/AppStyles.axaml"/>
    </Application.Styles>
</Application>
